
{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "AS Aluminio y Vidrio",
  "version": "1.0.0",
  "identifier": "com.as.aluminioyvidrio",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://127.0.0.1:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "AS Aluminio y Vidrio",
        "width": 1200,
        "height": 800,
        "minWidth": 950,
        "minHeight": 650,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "shortDescription": "Sistema de gestión de Acabados y Servicios",
    "longDescription": "Aplicación de escritorio para administrar clientes, proyectos y cotizaciones."
  }
}
